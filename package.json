{
  "name": "mood-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "tsc -b && oxlint --max-warnings 0 && prettier --check .",
    "fix": "oxlint --fix && prettier --write .",
    "build": "vite build",
    "build:dev": "npm run build",
    "build:ci": "VITE_BASE_PATH=/mood-visualizer npm run build",
    "postbuild": "tsx scripts/generate_rss.mts"
  },
  "dependencies": {
    "@types/file-saver": "^2.0.7",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "recharts-to-png": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
